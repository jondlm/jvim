    "sky":        "#99d1db",
    "sapphire":   "#85c1dc",
    "blue":       "#8caaee",
    "lavender":   "#babbf1",
    # Text / foreground scale
    "text":       "#c6d0f5",
    "subtext1":   "#b5bfe2",
    "subtext0":   "#a5adce",
    # Overlay scale
    "overlay2":   "#949cbb",
    "overlay1":   "#838ba7",
    "overlay0":   "#737994",
    # Surface scale
    "surface2":   "#626880",

# Vim-style half-page scrolling: cursor moves with the view
Sheet.addCommand('^D', 'scroll-halfpage-down', 'cursorDown(nScreenRows//2); sheet.topRowIndex += nScreenRows//2')
Sheet.addCommand('^U', 'scroll-halfpage-up', 'cursorDown(-nScreenRows//2); sheet.topRowIndex -= nScreenRows//2')

# Catppuccin Frappe theme for VisiData
# Uses exact hex colors (VisiData 3.x supports #rrggbb natively)

FRAPPE = {
    # Accents
    "rosewater":  "#f2d5cf",
    "flamingo":   "#eebebe",
    "pink":       "#f4b8e4",
    "mauve":      "#ca9ee6",
    "red":        "#e78284",
    "maroon":     "#ea999c",
    "peach":      "#ef9f76",
